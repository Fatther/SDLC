@startuml 04-state-product
title Состояния товара (Product)

[*] --> Active : add() / сохранить товар,\nназначить next_check_at

state Active {
  [*] --> InStock
  [H] -[hidden]-> InStock
  InStock --> OutOfStock : проверка: нет в наличии
  OutOfStock --> InStock : проверка: товар появился /\nуведомить пользователя
  InStock : do / периодическая проверка цены
  OutOfStock : do / периодическая проверка наличия
}

state CheckError : Ошибка проверки
CheckError : entry / уведомить один раз
CheckError : do / проверки продолжаются по расписанию

Active --> CheckError : 3 неудачные проверки подряд
CheckError --> Active[H] : успешная проверка /\nснять статус
Active --> Archived : archive()
CheckError --> Archived : archive()
Archived : проверки и алерты отключены
Active --> Deleted : delete()
CheckError --> Deleted : delete()
Archived --> Deleted : delete()
Deleted --> [*]
@enduml
