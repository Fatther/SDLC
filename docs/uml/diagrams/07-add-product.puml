@startuml 07-sequence-add-product
title Последовательность: добавление товара по ссылке (UC-04, UC-05)
autonumber
skinparam responseMessageBelowArrow true

actor "Покупатель" as U
boundary "Клиент SPA" as UI
control "ProductController" as PC
control "WishlistService" as WS
control "PriceApiFacade" as PF
participant "RateLimiter\n(по домену)" as RL
participant "Кэш\nPrice API" as C
participant "PriceSource\n(адаптер)" as AD
participant "Сайт магазина" as SH <<внешняя система>>
database "PostgreSQL" as DB

U -> UI : вставляет ссылку, нажимает «Добавить»
activate UI
UI -> PC : POST /api/v1/products {url}
activate PC
PC -> WS : addProduct(userId, url)
activate WS
WS -> PF : fetch(url)
activate PF
PF -> PF : validate(url): схема, домен, SSRF

alt URL недопустим или магазин не поддерживается
  PF --> WS : 400 / 422 (список магазинов)
  WS --> PC : ошибка
  PC --> UI : 4xx + сообщение
  UI --> U : «Магазин не поддерживается»
else URL допустим
  PF -> C : get(url)
  activate C
  C --> PF : запись или null
  deactivate C
  alt в кэше нет
    PF -> RL : acquire(domain)
    activate RL
    note right of RL : не более 1 запроса\nв 2 с на домен
    RL --> PF : токен выдан
    deactivate RL
    PF -> AD : extract(url)
    activate AD
    AD -> SH : GET страницы товара (таймаут 10 с)
    activate SH
    break магазин не ответил за 10 с
      SH --> AD : тайм-аут / ошибка
      AD --> PF : ошибка
      PF --> WS : 502 / 504
      WS --> PC : ошибка
      PC --> UI : 502 / 504
      UI --> U : «Магазин недоступен»
    end
    SH --> AD : HTML + JSON-LD
    deactivate SH
    AD --> PF : PriceQuote(title, price, inStock)
    deactivate AD
    PF -> C : put(url, quote)
  end
  PF --> WS : PriceQuote
  deactivate PF
  create entity "Product" as P
  WS -> P : new(userId, url, quote)
  WS -> DB : INSERT product, price_history
  activate DB
  DB --> WS : OK
  deactivate DB
  WS --> PC : Product
  deactivate WS
  PC --> UI : 201 Created
  deactivate PC
  UI --> U : карточка товара с ценой
  deactivate UI
end
@enduml
