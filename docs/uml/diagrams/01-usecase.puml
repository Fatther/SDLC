@startuml
left to right direction
skinparam linetype ortho

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam backgroundColor White
skinparam ArrowColor Black
skinparam ArrowFontSize 10
skinparam ActorBackgroundColor White
skinparam ActorBorderColor Black
skinparam ActorFontStyle bold
skinparam ActorStereotypeFontSize 10
skinparam usecase {
  BackgroundColor White
  BorderColor Black
  FontSize 11
}
skinparam rectangle {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
  FontSize 12
}
skinparam frame {
  BackgroundColor White
  BorderColor Black
  FontStyle bold
}
skinparam note {
  BackgroundColor White
  BorderColor Black
  FontSize 10
}

frame "uc  PriceRadar 1.0" {

  actor "Гость" as Guest
  actor "Покупатель" as Buyer
  actor "Администратор" as Admin
  actor "Таймер\n(планировщик)" as Timer <<time>>
  actor "Сайт магазина" as Shop <<system>>
  actor "Почтовый шлюз" as Mail <<system>>

  rectangle "PriceRadar" {
    usecase UC01 as "UC-01 Зарегистрироваться"
    usecase UC02 as "UC-02 Войти и выйти"
    usecase UC03 as "UC-03 Удалить учётную запись"

    usecase UC04 as "UC-04 Добавить товар по ссылке"
    usecase UC05 as "UC-05 Получить цену\nчерез Price API"
    usecase UC06 as "UC-06 Изменить параметры товара"
    usecase UC07 as "UC-07 Удалить или\nархивировать товар"
    usecase UC08 as "UC-08 Управлять списками"

    usecase UC09 as "UC-09 Настроить проверки и алерты"

    usecase UC10 as "UC-10 Просмотреть ленту скидок\n//extension points://\nскидка помечена как возможно фиктивная"
    usecase UC11 as "UC-11 Пометить фиктивную скидку"
    usecase UC12 as "UC-12 Просмотреть рекомендацию\nи график цены"
    usecase UC13 as "UC-13 Составить план покупок"
    usecase UC14 as "UC-14 Выгрузить историю в CSV"

    usecase UC15 as "UC-15 Опубликовать или отозвать\nссылку на список"
    usecase UC16 as "UC-16 Просмотреть публичный список"

    usecase UC17 as "UC-17 Проверить цену товара\n//extension points://\nцена изменилась и выполнено условие алерта"
    usecase UC18 as "UC-18 Доставить алерт"

    usecase UC19 as "UC-19 Редактировать календарь\nраспродаж"
    usecase UC20 as "UC-20 Включить или отключить\nадаптер магазина"

    note "condition (UC-18 → UC-17): цена изменилась\nи выполнено условие алерта" as N1

  }

  Admin --|> Buyer

  Guest --> UC01
  Guest --> UC16
  Buyer --> UC02
  Buyer --> UC03
  Buyer --> UC04
  Buyer --> UC06
  Buyer --> UC07
  Buyer --> UC08
  Buyer --> UC09
  Buyer --> UC10
  Buyer --> UC12
  Buyer --> UC13
  Buyer --> UC14
  Buyer --> UC15
  Admin --> UC19
  Admin --> UC20
  Timer --> UC17

  UC04 ..> UC05 : «include»
  UC17 ..> UC05 : «include»
  UC13 ..> UC12 : «include»
  UC11 ..> UC10 : «extend»
  UC18 ..> UC17 : «extend»

  UC05 --> Shop
  UC01 --> Mail
  UC18 --> Mail
}
@enduml